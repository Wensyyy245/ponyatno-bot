BOT_TOKEN=123456789:AA...

# относительный путь считается от папки проекта, а не от текущего каталога
DB_PATH=data/ponyatno.sqlite3

# --- AI (OpenAI-совместимый шлюз) ---
AI_BASE_URL=https://api.ranvik.ru/v1
AI_MODEL=gemini-2.5-flash
AI_API_KEY=
AI_API_KEYS=
AI_TIMEOUT=90
AI_MAX_TOKENS=2200
AI_TEMPERATURE=0.3

# --- экономика ---
# сколько разборов бесплатно начисляется каждый день
FREE_SOLVES_PER_DAY=3
# сколько запросов получает пригласивший за друга, подписанного на канал
REF_REWARD_REQUESTS=5

# --- канал для рефералки ---
# оставь пустым, если канала нет: бонус будет начисляться сразу после перехода
CHANNEL_ID=
CHANNEL_URL=

SOLVE_COOLDOWN_SEC=5
MAX_PHOTO_MB=6
TZ_OFFSET=3
LOG_LEVEL=INFO